rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyEditor() {
      return isSignedIn()
        && request.auth.uid == 'PUF4asydCxQE6r3VzbCMw3c0gF62';
    }

    match /{document=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isFamilyEditor();
    }
  }
}
